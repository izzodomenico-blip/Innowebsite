# ─────────────────────────────────────────────────────────────────────────────
# Area Clienti — variabili d'ambiente (FASE G3).
# Copia questo file in `.env.local` e compila con i valori del TUO progetto
# Supabase. NON committare `.env.local` (è ignorato da git).
# Le credenziali NON sono incluse qui: vanno create da te nella dashboard Supabase.
# ─────────────────────────────────────────────────────────────────────────────

# Pubbliche (client) — sicure da esporre nel browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Segreta (SOLO server) — bypassa l'RLS: non metterla MAI in variabili NEXT_PUBLIC_*
# e non esporla al client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
